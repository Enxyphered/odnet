@props(type: string = "text", placeholder: string = "", value: string = "")

<input
  type="{type}"
  placeholder="{placeholder}"
  value="{value}"
  class="flex h-11 w-full rounded-lg border border-input border-slate-200 bg-white px-3.5 py-2 text-sm text-slate-900 shadow-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition disabled:cursor-not-allowed disabled:opacity-50"
/>
