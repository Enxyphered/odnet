@props(books: []Book, title: string = "Curated Computer Science Library")

<div>
  <!-- Catalog Page Header -->
  <div class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-200">
    <div>
      <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">{title}</h1>
      <p class="text-sm text-slate-500 mt-1">Foundational systems programming, interpreters, and computer architecture texts</p>
    </div>
    <div class="self-start sm:self-auto">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        {len(books)} titles available
      </span>
    </div>
  </div>

  @if (len(books) == 0) {
    <div class="p-12 text-center text-slate-500 bg-white rounded-2xl border border-dashed border-slate-200">
      <p class="text-base font-medium">No books currently available.</p>
    </div>
  } @else {
    <!-- 2-Column Responsive Card Grid -->
    <div class="book-grid grid grid-cols-1 sm:grid-cols-2 gap-5">
      @foreach book, idx in books {
        @BookCard(book: book, show_price: true, index: idx + 1)
      }
    </div>
  }

  <!-- Catalog Footer -->
  <div class="mt-10 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-3">
    <div class="flex items-center gap-1.5 text-amber-500">
      @for i in 0..<3 {
        <span class="star">★</span>
      }
      <span class="text-slate-500 ml-1 font-medium">Curated for systems and compiler engineers</span>
    </div>
    <span class="text-slate-400 font-mono text-[11px]">Powered by odnetlib & odnetgen</span>
  </div>
</div>
