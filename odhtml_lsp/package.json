{
  "name": "odhtml-lsp",
  "displayName": "Odin HTML (odhtml) Language Support",
  "description": "Native Odin Language Server and syntax highlighting for odnet .odhtml template components",
  "version": "0.1.0",
  "publisher": "odnet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/odnet/odnet.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "odin",
    "odnet",
    "odhtml",
    "templates",
    "lsp"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:odhtml"
  ],
  "contributes": {
    "languages": [
      {
        "id": "odhtml",
        "aliases": [
          "Odin HTML",
          "odhtml"
        ],
        "extensions": [
          ".odhtml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/html.svg",
          "dark": "./icons/html.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "odhtml",
        "scopeName": "text.html.odhtml",
        "path": "./syntaxes/odhtml.tmLanguage.json",
        "embeddedLanguages": {
          "text.html": "html",
          "source.odin": "odin"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "odhtml Configuration",
      "properties": {
        "odhtml.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the native odhtml-lsp executable (defaults to output/odhtml-lsp.exe or PATH)."
        }
      }
    },
    "commands": [
      {
        "command": "odhtml.restartServer",
        "title": "odhtml: Restart Language Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/src/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/src/extension.js --external:vscode --format=cjs --platform=node --watch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  }
}
